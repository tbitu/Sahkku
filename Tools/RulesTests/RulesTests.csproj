<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless runner for the rules engine tests (Assets/Tests/Rules).

    The engine (Sahkku.Rules) only depends on System.*, so the exact same sources that Unity
    compiles also compile here. This project exists so `dotnet test Tools/RulesTests` can verify
    the rules — including the shipped SahkkuRules.json — without a Unity installation, which makes
    the ruleset CI-verifiable.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Sahkku.Rules.Tests.Headless</AssemblyName>
    <RootNamespace>Sahkku.Rules.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The Unity sources are old-style C#; keep warnings from failing the run for now. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Sahkku/Assets/Scripts/Rules/**/*.cs" />
    <!-- The agents are plain C#: only PlayerAgents.cs, LlmClient.cs and LlmPlayerAgent.cs of the Unity
         bridge layer are engine-free (ActionSources.cs and RuleSetProvider.cs reach into UnityEngine). -->
    <Compile Include="../../Sahkku/Assets/Scripts/RulesBridge/PlayerAgents.cs" />
    <Compile Include="../../Sahkku/Assets/Scripts/RulesBridge/LlmClient.cs" />
    <Compile Include="../../Sahkku/Assets/Scripts/RulesBridge/LlmPlayerAgent.cs" />
    <!-- The benchmark harness (Tools/SahkkuBench) is a plain .NET 8 console app: its runner, its
         statistics and its LLM fallback counter are engine-free too, so the same sources are compiled
         here and covered by BenchmarkTests. Program.cs is left out — the CLI itself is a smoke-test
         surface, not a unit. -->
    <Compile Include="../SahkkuBench/MatchRunner.cs" />
    <Compile Include="../SahkkuBench/BenchmarkStats.cs" />
    <Compile Include="../SahkkuBench/LlmFallbackCounter.cs" />
    <Compile Include="../../Sahkku/Assets/Tests/Rules/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- NUnit 3.x to match the classic API Unity's Test Runner ships (Assert.AreEqual etc.). -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
